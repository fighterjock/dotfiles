# Caddy as the single L7 router ahead of Tailscale "serve".
#
# Tailscale "serve" terminates HTTPS for the tailnet and forwards to Caddy on
# 127.0.0.1:8080. Caddy dispatches to every backend service (multiple
# crushdecks and other servers) using HTTP Host-header + path rules, so you get
# ONE tailnet entry point fanning out to N backends.
#
# crushdeck's embedded frontend uses RELATIVE asset/API paths (static/...,
# api/...), so each instance works untouched under its own path prefix.
#
# Bind only to loopback: Tailscale serve is the only network-facing entry.
:8080 {
	# ---- crushdeck instance A (127.0.0.1:4443) under /cd-a/ ----
	handle_path /cd-a/* {
		reverse_proxy 127.0.0.1:4443
	}
	handle_path /cd-a {
		reverse_proxy 127.0.0.1:4443
	}

	# ---- root: favicon (return empty to avoid 404 noise) ----
	handle /favicon.ico {
		respond "" 204
	}

	# ---- root only: inline landing page listing available sub-routes ----
	handle / {
		header Content-Type text/html
		respond "<!DOCTYPE html>
<html lang=\"en\">
<head>
<meta charset=\"utf-8\">
<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">
<title>Tailnet gateway</title>
<style>
  :root { color-scheme: light dark; }
  body { font-family: system-ui, -apple-system, sans-serif; max-width: 720px; margin: 48px auto; padding: 0 20px; line-height: 1.5; }
  h1 { font-size: 1.5rem; margin-bottom: 4px; }
  p.sub { color: #888; margin-top: 0; }
  ul { list-style: none; padding: 0; }
  li { margin: 10px 0; }
  a { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; border: 1px solid #444; border-radius: 8px; text-decoration: none; color: inherit; background: #1a1a1a; transition: background .15s ease; }
  a:hover { background: #262626; }
  .name { font-weight: 600; }
  .desc { color: #aaa; font-size: .9rem; }
</style>
</head>
<body>
  <h1>Tailnet gateway</h1>
  <p class=\"sub\">rudreshs-macbook-air.tail74e18e.ts.net &middot; services</p>
  <ul>
    <li><a href=\"/cd-a/\"><span><span class=\"name\">Crushdeck</span><br><span class=\"desc\">crush backend on 127.0.0.1:4443</span></span><span>&rarr;</span></a></li>
  </ul>
</body>
</html>"
	}
}
