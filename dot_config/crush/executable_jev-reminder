#!/bin/sh
# PreToolUse hook "jev-edit-reminder" (wired in crushrc): fires on every
# top-level edit/write/lsp* call and reminds the agent to jev-check the diff
# once the whole change is finished, mirroring CRUSH.md, "Use jev while coding".
# Docs-only edits (.md/.txt) just get {} so prose edits stay noise-free.
set -eu

f="${CRUSH_TOOL_INPUT_FILE_PATH:-}"
case "$f" in
  *.md|*.txt)
    echo "$(date '+%H:%M:%S') ${CRUSH_TOOL_NAME:-?} $f skip" >> "${TMPDIR:-/tmp}/crush-jev-reminder.log" || true
    echo '{}'
    ;;
  *)
    echo "$(date '+%H:%M:%S') ${CRUSH_TOOL_NAME:-?} $f remind" >> "${TMPDIR:-/tmp}/crush-jev-reminder.log" || true
    printf '%s\n' '{"context":"Code changed. When this change is finished (not after every edit), run exactly one jev check on the diff: does it introduce a real bug? probability_yes > 0.3 means reread the flagged code before continuing. Skip parley review only if this was a single small fix and probability_yes <= 0.3. See CRUSH.md, Use jev while coding."}'
    ;;
esac
