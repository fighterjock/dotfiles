#!/usr/bin/env bash

if [ -f "$HOME/.crush_env" ]; then
    source "$HOME/.crush_env"
fi

# DevPass provider, live model pricing (fetched from the gateway catalog), and
# large/small defaults live in their own file so other configs can source it.
source "$HOME/.config/crush/devpass.sh"

model large devpass/deepseek-v4-flash
model small devpass/deepseek-v4-flash

# Clean commits: no 💘 banner, no attribution footer
option attribution-trailer-style none
option attribution-generated-with false

# MCP servers are defined one-per-file in ~/.config/crush/mcp/, enabled by
# sourcing. Source the ones you want everywhere here; a project's .crushrc can
# source a different subset (and wins on conflicts).
source "$HOME/.config/crush/mcp/devpass.sh"
source "$HOME/.config/crush/mcp/parley.sh"

# Language servers are per-project: define gopls (or others) in each project's
# .crushrc so they only load where they apply.

# Ring the terminal bell when Crush needs permission/input or finishes its
# turn; tmux then flags the window (yellow !) and beeps for background ones
option notifications bell
